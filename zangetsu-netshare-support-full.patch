+/**
+ * A [Dns] that FOLLOWS the user's dns_choice at runtime, for the OkHttp
+ * clients built once outside [PluginHost.applyBaseClient]
+ * (ExternalStreamProxy, NovelHttp). Rebuilding those clients on every settings
+ * change would drop live sessions; instead each lookup re-reads
+ * [PluginHost.currentDnsChoice] (a volatile int compare — free) and delegates
+ * to the matching resolver, built once per choice. OFF → system DNS, which is
+ * exactly what those clients did before this existed.
+ *
+ * The DoH resolver here is built on its own throwaway client rather than the
+ * caller's: a [DnsOverHttps] must not route through the very client it
+ * resolves for (bootstrap recursion), and Tachiyomi's original pattern
+ * captures the client-so-far the same way.
+ */
+object SelectableDns : Dns {
+    @Volatile private var builtFor: Int = Int.MIN_VALUE
+    @Volatile private var delegate: Dns = Dns.SYSTEM
+
+    override fun lookup(hostname: String): List<InetAddress> {
+        val choice = PluginHost.currentDnsChoice()
+        if (choice != builtFor) {
+            // OFF (or a failed build) → OkHttpClient's default resolver is
+            // Dns.SYSTEM, which is exactly what these clients did before.
+            delegate = runCatching {
+                Doh.apply(OkHttpClient.Builder(), choice).build().dns
+            }.getOrDefault(Dns.SYSTEM)
+            builtFor = choice
+        }
+        return delegate.lookup(hostname)
+    }
+}
