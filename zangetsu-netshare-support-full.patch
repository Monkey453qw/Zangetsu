index 0000000..8893626
--- /dev/null
+++ b/lib/core/net/doh_client.dart
@@ -0,0 +1,388 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+import 'dart:math';
+import 'dart:typed_data';
+
+import 'package:flutter/services.dart';
+
+/// DNS-over-HTTPS (RFC 8484) client with hard-coded bootstrap IPs.
+///
+/// The Dart network stack (every `HttpClient`/dio call in the app) resolves
+/// hostnames through the OS resolver. When Android "Private DNS" is in strict
+/// mode (e.g. `dns.adguard.com`), the OS resolves over DNS-over-TLS on
+/// TCP port 853 — and on networks that block that port every lookup fails and
+/// every connection freezes until it times out. This client is the escape
+/// hatch: it resolves over HTTPS on port 443, which reaches the internet on
+/// exactly the networks where :853 is dead.
+///
+/// Mirrors the native `Doh.kt` (CloudStream lane): the bootstrap IPs are
+/// literals, so the DoH endpoint itself is resolved without touching DNS at
+/// all. The TLS session for the query connects to the bootstrap IP but
+/// presents/verifies the provider's real hostname (SNI + certificate), which
+/// is what `bootstrapDnsHosts` does for OkHttp's [DnsOverHttps].
+///
+/// Used only as a FALLBACK (see resilient_http_overrides.dart): on a healthy
+/// network the OS resolver answers first and this class is never called.
+class DohClient {
+  DohClient._();
+
+  static final DohClient instance = DohClient._();
+
+  /// Provider ids — the same numbers the native side persists in
+  /// `zangetsu_cs/dns_choice` (see Doh.kt and lib/core/provider/cs_dns.dart),
+  /// so one setting covers both lanes.
+  static const int off = 0;
+  static const int cloudflare = 1;
+  static const int google = 2;
+  static const int adguard = 3;
+  static const int quad9 = 4;
+
+  /// How long one OS lookup is allowed to take before we declare it dead.
+  /// Android's DoT retry ladder can stall a lookup for 10+s on a network
+  /// where :853 is blocked; we bail much earlier and switch to DoH.
+  static const Duration osLookupTimeout = Duration(seconds: 3);
+
+  /// Cache TTL — segments/keys on one CDN host would otherwise re-query DoH
+  /// for every connection.
+  static const Duration cacheTtl = Duration(seconds: 60);
+
+  static const _maxCacheEntries = 128;
+
+  String? _preferredHost; // provider hostname, e.g. cloudflare-dns.com
+  List<String> _preferredIps = const [];
+
+  final Map<String, _CacheEntry> _cache = {};
+  final Random _random = Random.secure();
+
+  /// Picks the provider matching [choice] (the persisted dns_choice int).
+  /// [off] or an unknown value falls back to Cloudflare — the fallback
+  /// resolver must have SOME provider to be useful, and Cloudflare's
+  /// anycast is the most reliably reachable of the four.
+  void configure(int choice) {
+    switch (choice) {
+      case cloudflare:
+        _set('cloudflare-dns.com', const [
+          '1.1.1.1',
+          '1.0.0.1',
+          '162.159.36.1',
+          '162.159.46.1',
+        ]);
+      case google:
+        _set('dns.google', const ['8.8.8.8', '8.8.4.4']);
+      case adguard:
+        _set('dns.adguard-dns.com', const ['94.140.14.14', '94.140.15.15']);
+      case quad9:
+        _set('dns.quad9.net', const ['9.9.9.9', '149.112.112.112']);
+      default:
+        _set('cloudflare-dns.com', const ['1.1.1.1', '1.0.0.1']);
+    }
+  }
+
+  void _set(String host, List<String> ips) {
+    _preferredHost = host;
+    _preferredIps = ips;
+  }
+
+  /// Resolves [host] to addresses via DoH. IPv4 first (the networks where the
+  /// OS resolver dies are usually IPv4 hotspots); AAAA only when there is no
+  /// A record. Null when every bootstrap IP failed — the caller then falls
+  /// through to the native path so the original error surfaces instead of a
+  /// fabricated one.
+  Future<List<InternetAddress>?> lookup(String host) async {
+    final cached = _cache[host];
+    if (cached != null && cached.expiresAt.isAfter(DateTime.now())) {
+      return cached.addresses;
+    }
+    _pruneCache();
+
+    // Lazy default: most calls arrive before anyone configured a provider.
+    if (_preferredHost == null) configure(cloudflare);
+
+    final addresses = await _lookupUncached(host);
+    if (addresses == null || addresses.isEmpty) return null;
+    _cache[host] = _CacheEntry(addresses, DateTime.now().add(cacheTtl));
+    return addresses;
+  }
+
+  Future<List<InternetAddress>?> _lookupUncached(String host) async {
+    final deadline = DateTime.now().add(const Duration(seconds: 6));
+    for (final ip in _preferredIps) {
+      if (DateTime.now().isAfter(deadline)) return null;
+      final addr = InternetAddress.tryParse(ip);
+      if (addr == null) continue;
+      try {
+        var bytes = await _query(addr, host, 1); // A
+        var ips = parseDohResponse(bytes);
+        if (ips != null && ips.isEmpty) {
+          bytes = await _query(addr, host, 28); // AAAA
+          ips = parseDohResponse(bytes);
+        }
+        if (ips == null) continue; // rcode error / malformed → next bootstrap
+        final parsed = <InternetAddress>[];
+        for (final s in ips) {
+          final a = InternetAddress.tryParse(s);
+          if (a != null) parsed.add(a);
+        }
+        if (parsed.isNotEmpty) {
+          parsed.sort((a, b) => _rank(a).compareTo(_rank(b))); // IPv4 first
+          return parsed;
+        }
+      } catch (_) {
+        // bootstrap refused / TLS failed / timed out → try the next IP
+      }
+    }
+    return null;
+  }
+
+  static int _rank(InternetAddress a) =>
+      a.type == InternetAddressType.IPv4 ? 0 : 1;
+
+  void _pruneCache() {
+    if (_cache.length < _maxCacheEntries) return;
+    final now = DateTime.now();
+    _cache.removeWhere((_, e) => e.expiresAt.isBefore(now));
+    while (_cache.length >= _maxCacheEntries) {
+      _cache.remove(_cache.keys.first);
+    }
+  }
+
+  /// Sends one DoH query to the bootstrap IP at [addr] and returns the raw
+  /// DNS-message response body. The TCP connection goes to the IP; the TLS
+  /// handshake presents and verifies the provider's hostname.
+  Future<Uint8List> _query(InternetAddress addr, String host, int qtype) async {
+    final hostHeader = _preferredHost!;
+    Socket? raw;
+    SecureSocket? tls;
+    try {
+      raw = await Socket.startConnect(addr, 443)
+          .then((t) => t.socket)
+          .timeout(
+            const Duration(seconds: 3),
+            onTimeout: () {
+              throw SocketException('DoH connect timeout ($hostHeader)');
+            },
+          );
+      tls = await SecureSocket.secure(raw, host: hostHeader).timeout(
+        const Duration(seconds: 4),
+        onTimeout: () {
+          throw SocketException('DoH TLS timeout ($hostHeader)');
+        },
+      );
+      final id = _random.nextInt(1 << 16);
+      final query = buildDohQuery(host, id: id, qtype: qtype);
+      final b64 = base64Url.encode(query).replaceAll('=', '');
+      // `connection: close` makes the body end at EOF, so no chunked /
+      // content-length parsing is needed for the response.
+      tls.write(
+        'GET /dns-query?dns=$b64 HTTP/1.1\r\n'
+        'Host: $hostHeader\r\n'
+        'accept: application/dns-message\r\n'
+        'user-agent: Zangetsu-DoH/1\r\n'
+        'connection: close\r\n'
+        '\r\n',
+      );
+      await tls.flush();
+      final response = await _readAll(tls, budget: const Duration(seconds: 5));
+      final sep = _findHeaderEnd(response);
+      if (sep < 0) throw const FormatException('no HTTP header end from DoH');
+      final lineEnd = response.indexOf(0x0D);
+      final statusLine = utf8.decode(response.sublist(0, lineEnd));
+      final parts = statusLine.split(' ');
+      if (parts.length < 2 || parts[1] != '200') {
+        throw HttpException('DoH answered "$statusLine"');
+      }
+      return Uint8List.sublistView(response, sep + 4);
+    } catch (_) {
+      try {
+        tls?.destroy();
+      } catch (_) {}
+      try {
+        raw?.destroy();
+      } catch (_) {}
+      rethrow;
+    }
+  }
+
+  static int _findHeaderEnd(List<int> bytes) {
+    for (var i = 0; i + 3 < bytes.length; i++) {
+      if (bytes[i] == 0x0D &&
+          bytes[i + 1] == 0x0A &&
+          bytes[i + 2] == 0x0D &&
+          bytes[i + 3] == 0x0A) {
+        return i;
+      }
+    }
+    return -1;
+  }
+
+  /// Reads a socket until EOF (its peer half-closes) and returns everything.
+  static Future<Uint8List> _readAll(Socket socket, {required Duration budget}) {
+    final completer = Completer<Uint8List>();
+    final builder = BytesBuilder(copy: false);
+    late final StreamSubscription<Uint8List> sub;
+    void finish() {
+      if (completer.isCompleted) return;
+      try {
+        socket.destroy();
+      } catch (_) {}
+      completer.complete(builder.takeBytes());
+    }
+
+    sub = socket.listen(
+      builder.add,
+      onDone: finish,
+      onError: (Object e) {
+        if (completer.isCompleted) return;
+        try {
+          socket.destroy();
+        } catch (_) {}
+        completer.completeError(e);
+      },
+    );
+    Timer(budget, () {
+      if (!completer.isCompleted) {
+        sub.cancel();
+        try {
+          socket.destroy();
+        } catch (_) {}
+        completer.completeError(SocketException('DoH read timeout'));
+      }
+    });
+    return completer.future;
+  }
+
+  /// Reads the persisted native dns_choice once (best-effort) and configures
+  /// the provider, so the Dart fallback and the CloudStream lane follow the
+  /// same user setting.
+  static Future<void> configureFromNativePrefs() async {
+    try {
+      final choice =
+          await const MethodChannel('zangetsu/cloudstream')
+              .invokeMethod<int>('getDns') ??
+          cloudflare;
+      instance.configure(choice);
+    } catch (_) {
+      instance.configure(cloudflare);
+    }
+  }
+}
+
+class _CacheEntry {
+  _CacheEntry(this.addresses, this.expiresAt);
+  final List<InternetAddress> addresses;
+  final DateTime expiresAt;
+}
+
+// ── DNS wire format (RFC 1035) ───────────────────────────────────────────────
+// Pure functions, unit-tested against hand-built fixtures (test/core/net).
+
+/// Builds a recursive A/AAAA query for [host]. [id] is injectable so tests
+/// can assert the exact bytes.
+Uint8List buildDohQuery(String host, {required int id, int qtype = 1}) {
+  final labels = host.split('.');
+  final body = BytesBuilder();
+  for (final label in labels) {
+    if (label.isEmpty || label.length > 63) {
+      throw ArgumentError.value(host, 'host', 'invalid DNS label');
+    }
+    final bytes = ascii.encode(label);
+    body.addByte(bytes.length);
+    body.add(bytes);
+  }
+  body.addByte(0); // root label
+  body.add(Uint8List.fromList([0, qtype])); // QTYPE
+  body.add(Uint8List.fromList([0, 1])); // QCLASS = IN
+
+  final out = BytesBuilder();
+  out.add(Uint8List.fromList([(id >> 8) & 0xFF, id & 0xFF]));
+  out.add(Uint8List.fromList([0x01, 0x00])); // flags: RD=1
+  out.add(Uint8List.fromList([0, 1])); // QDCOUNT = 1
+  out.add(Uint8List.fromList([0, 0, 0, 0, 0, 0])); // AN/NS/ARCOUNT = 0
+  out.add(body.takeBytes());
+  return out.takeBytes();
+}
+
+/// Parses a DNS response message into A/AAAA address strings.
+/// Null when the message is malformed or carries an error rcode
+/// (NXDOMAIN etc.) — indistinguishable to the caller: no addresses.
+List<String>? parseDohResponse(List<int> b) {
+  if (b.length < 12) return null;
+  final rcode = b[3] & 0x0F;
+  if (rcode != 0) return null;
+  final answerCount = (b[6] << 8) | b[7];
+  if (answerCount == 0) return const [];
+
+  // Skip the question section: QNAME (labels, compression possible in
+  // theory) then QTYPE(2) + QCLASS(2).
+  var o = _skipName(b, 12);
+  if (o < 0 || o + 4 > b.length) return null;
+  o += 4;
+
+  final out = <String>[];
+  for (var i = 0; i < answerCount; i++) {
+    o = _skipName(b, o); // owner name (usually a compression pointer)
+    if (o < 0 || o + 10 > b.length) return out.isEmpty ? null : out;
+    final type = (b[o] << 8) | b[o + 1];
+    final rdlength = (b[o + 8] << 8) | b[o + 9];
+    o += 10;
+    if (o + rdlength > b.length) return out.isEmpty ? null : out;
+    if (type == 1 && rdlength == 4) {
+      out.add('${b[o]}.${b[o + 1]}.${b[o + 2]}.${b[o + 3]}');
+    } else if (type == 28 && rdlength == 16) {
+      out.add(_formatIpv6(b, o));
+    }
+    o += rdlength;
+  }
+  return out;
+}
+
+/// Advances past a (possibly compressed) name. Returns the offset just after
+/// it, or -1 on malformed input.
+///
+/// A compression pointer TERMINATES the name (RFC 1035 §4.1.4): the caller
+/// resumes at pointer+2 in the original stream. We deliberately do NOT follow
+/// the pointer — the name's content is irrelevant when skipping, and not
+/// following makes runaway-pointer loops impossible by construction.
+int _skipName(List<int> b, int start) {
+  var o = start;
+  while (true) {
+    if (o >= b.length) return -1;
+    final len = b[o];
+    if (len == 0) return o + 1;
+    if (len & 0xC0 == 0xC0) {
+      if (o + 1 >= b.length) return -1;
+      return o + 2;
+    }
+    if (len & 0xC0 != 0) return -1; // reserved label types
+    o += 1 + len;
+  }
+}
+
+/// Formats 16 bytes as IPv6 text (lowercase, longest zero-run collapsed) in
+/// the form [InternetAddress.parse] accepts.
+String _formatIpv6(List<int> b, int o) {
+  final groups = [
+    for (var i = 0; i < 8; i++) (b[o + 2 * i] << 8) | b[o + 2 * i + 1],
+  ];
+  var bestStart = -1, bestLen = 0, curStart = -1, curLen = 0;
+  for (var i = 0; i < 8; i++) {
+    if (groups[i] == 0) {
+      if (curStart < 0) curStart = i;
+      curLen++;
+      if (curLen > bestLen) {
+        bestStart = curStart;
+        bestLen = curLen;
+      }
+    } else {
+      curStart = -1;
+      curLen = 0;
+    }
+  }
+  String hex(int v) => v.toRadixString(16);
+  if (bestLen < 2) return groups.map(hex).join(':');
+  final head = [for (var i = 0; i < bestStart; i++) hex(groups[i])].join(':');
+  final tail = [for (var i = bestStart + bestLen; i < 8; i++) hex(groups[i])]
+      .join(':');
+  return '$head::$tail';
+}
