diff --git a/test/core/net/doh_client_test.dart b/test/core/net/doh_client_test.dart
new file mode 100644
index 0000000..04ccc54
--- /dev/null
+++ b/test/core/net/doh_client_test.dart
@@ -0,0 +1,121 @@
+import 'dart:typed_data';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:watch_app/core/net/doh_client.dart';
+
+// Fixtures are real DNS wire messages, generated independently (Python,
+// struct-packed) and cross-checked with a separate decoder — not derived
+// from the implementation under test. The A-record fixture carries a CNAME
+// chain (answer 1) whose owner names use compression pointers (answer 2),
+// the classic shape of a real recursive answer.
+
+const _queryExampleCom =
+    '123401000001000000000000'
+    '076578616d706c6503636f6d0000010001';
+
+const _respAWithCnameChain =
+    '123481800001000200000000076578616d706c6503636f6d0000010001'
+    '076578616d706c6503636f6d00000500010000012c001103777777076578616d706c65'
+    '03636f6d00c034000100010000003c00045db8d822';
+
+const _respAaaa =
+    '0bb881800001000100000000046970763606676f6f676c6503636f6d00'
+    '001c0001046970763606676f6f676c6503636f6d00001c0001000000780010'
+    '26064700470000000000000000001111';
+
+const _respNxdomain =
+    '000181830001000000000000046e6f7065076578616d706c6503636f6d0000010001';
+
+const _respNoAnswers =
+    '00028180000100000000000005656d707479076578616d706c6503636f6d0000010001';
+
+Uint8List _hex(String h) => Uint8List.fromList([
+  for (var i = 0; i + 1 < h.length; i += 2)
+    int.parse(h.substring(i, i + 2), radix: 16),
+]);
+
+void main() {
+  group('buildDohQuery', () {
+    test('encodes example.com A with the exact wire bytes', () {
+      final q = buildDohQuery('example.com', id: 0x1234, qtype: 1);
+      expect(q, _hex(_queryExampleCom));
+    });
+
+    test('encodes an AAAA query (qtype 28)', () {
+      final q = buildDohQuery('a.b', id: 0, qtype: 28);
+      // header(12) + labels + root + qtype + qclass
+      expect(q.length, 12 + 2 + 2 + 1 + 2 + 2);
+      expect(q[12], 1);
+      expect(q.sublist(q.length - 4), [0, 28, 0, 1]);
+    });
+
+    test('rejects empty and oversized labels', () {
+      expect(() => buildDohQuery('.example.com', id: 1), throwsArgumentError);
+      expect(
+        () => buildDohQuery('${'x' * 64}.com', id: 1),
+        throwsArgumentError,
+      );
+    });
+  });
+
+  group('parseDohResponse', () {
+    test('extracts the A record behind a CNAME chain with pointers', () {
+      expect(parseDohResponse(_hex(_respAWithCnameChain)), ['93.184.216.34']);
+    });
+
+    test('extracts an IPv6 address from an AAAA answer', () {
+      expect(parseDohResponse(_hex(_respAaaa)), ['2606:4700:4700::1111']);
+    });
+
+    test('NXDOMAIN (rcode 3) → null', () {
+      expect(parseDohResponse(_hex(_respNxdomain)), isNull);
+    });
+
+    test('NOERROR with zero answers → empty list', () {
+      expect(parseDohResponse(_hex(_respNoAnswers)), isEmpty);
+    });
+
+    test('truncated garbage → null, never throws', () {
+      expect(parseDohResponse(Uint8List.fromList([1, 2, 3])), isNull);
+      expect(parseDohResponse(Uint8List(0)), isNull);
+      // Header claiming 1 answer but no body.
+      expect(
+        parseDohResponse(
+          Uint8List.fromList([0, 1, 0x81, 0x80, 0, 1, 0, 1, 0, 0, 0, 0, 0]),
+        ),
+        isNull,
+      );
+    });
+
+    test('compression pointer at the start of an answer parses through', () {
+      // Owner name is a pointer to the (empty root) question name — the
+      // pointer terminates the name and parsing must resume right after it,
+      // not inside the jump target.
+      final msg = Uint8List.fromList([
+        0, 1, 0x81, 0x80, 0, 1, 0, 1, 0, 0, 0, 0, // header
+        0, // question name: root
+        0, 1, 0, 1, // QTYPE=A QCLASS=IN
+        0xC0, 0x0C, // owner: pointer to offset 12
+        0, 1, 0, 1, 0, 0, 0, 60, 0, 4, // A, IN, ttl, rdlen 4
+        1, 2, 3, 4, // rdata
+      ]);
+      expect(parseDohResponse(msg), ['1.2.3.4']);
+    });
+  });
+
+  group('DohClient.configure', () {
+    test('accepts every provider id without throwing', () {
+      final c = DohClient.instance;
+      for (final id in [
+        DohClient.off,
+        DohClient.cloudflare,
+        DohClient.google,
+        DohClient.adguard,
+        DohClient.quad9,
+        99, // unknown → falls back to a working default
+      ]) {
+        expect(() => c.configure(id), returnsNormally);
+      }
+    });
+  });
+}
diff --git a/test/core/net/resilient_http_overrides_test.dart b/test/core/net/resilient_http_overrides_test.dart
new file mode 100644
index 0000000..dae259c
--- /dev/null
+++ b/test/core/net/resilient_http_overrides_test.dart
@@ -0,0 +1,339 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+import 'dart:typed_data';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:watch_app/core/net/resilient_http_overrides.dart';
+
+/// Collects everything a socket sends and hands out prefixes on demand.
+/// Sockets are single-subscription streams, so one persistent listener per
+/// socket serves every `take` in a test. Only used on sockets the relay does
+/// NOT listen (the relay owns both ends of its pair).
+class _Reader {
+  _Reader(Socket s) {
+    _sub = s.listen(
+      (chunk) {
+        _acc.addAll(chunk);
+        _wake();
+      },
+      onDone: () {
+        _closed = true;
+        _wake();
+      },
+      onError: (Object e) {
+        _closed = true;
+        _error = e;
+        _wake();
+      },
+    );
+  }
+
+  final List<int> _acc = [];
+  final List<Completer<void>> _waiters = [];
+  late final StreamSubscription<Uint8List> _sub;
+  bool _closed = false;
+  Object? _error;
+
+  void _wake() {
+    for (final c in _waiters) {
+      if (!c.isCompleted) c.complete();
+    }
+    _waiters.clear();
+  }
+
+  Future<Uint8List> take(int n) async {
+    while (_acc.length < n && !_closed) {
+      final c = Completer<void>();
+      _waiters.add(c);
+      if (_acc.length < n && !_closed) await c.future;
+    }
+    if (_acc.length < n) {
+      throw StateError(
+        'socket closed with ${_acc.length} of $n bytes ($_error)',
+      );
+    }
+    final out = Uint8List.fromList(_acc.sublist(0, n));
+    _acc.removeRange(0, n);
+    return out;
+  }
+
+  void close() => _sub.cancel();
+}
+
+List<int> _ascii(String s) => s.codeUnits;
+
+Future<void> _until(bool Function() condition) async {
+  for (var i = 0; i < 200; i++) {
+    if (condition()) return;
+    await pumpEventQueue();
+  }
+  fail('condition not reached');
+}
+
+void main() {
+  setUp(resetResolverState);
+
+  group('pickConnectPath (the resolver policy)', () {
+    test('literal IPs never touch a resolver', () {
+      expect(
+        pickConnectPath(
+          host: '192.168.1.23',
+          isSecure: false,
+          osAlive: false,
+          dohAlive: true,
+        ),
+        ConnectPath.nativeLiteral,
+      );
+      expect(
+        pickConnectPath(
+          host: '2606:4700:4700::1111',
+          isSecure: true,
+          osAlive: false,
+          dohAlive: true,
+        ),
+        ConnectPath.nativeLiteral,
+      );
+    });
+
+    test('healthy OS resolver → stock SDK path (http and https)', () {
+      for (final secure in [false, true]) {
+        expect(
+          pickConnectPath(
+            host: 'example.com',
+            isSecure: secure,
+            osAlive: true,
+            dohAlive: true,
+          ),
+          ConnectPath.native,
+        );
+      }
+    });
+
+    test('OS dead + DoH alive → rescue (plain vs relay by scheme)', () {
+      expect(
+        pickConnectPath(
+          host: 'cdn.example.com',
+          isSecure: false,
+          osAlive: false,
+          dohAlive: true,
+        ),
+        ConnectPath.dohPlain,
+      );
+      expect(
+        pickConnectPath(
+          host: 'cdn.example.com',
+          isSecure: true,
+          osAlive: false,
+          dohAlive: true,
+        ),
+        ConnectPath.dohTlsRelay,
+      );
+    });
+
+    test('OS dead + DoH dead → native (surface the real error)', () {
+      expect(
+        pickConnectPath(
+          host: 'cdn.example.com',
+          isSecure: true,
+          osAlive: false,
+          dohAlive: false,
+        ),
+        ConnectPath.native,
+      );
+    });
+  });
+
+  group('LoopbackRelay', () {
+    // The relay listens BOTH ends of its pair, so the test observes at the
+    // echo SERVER side (its own sockets) and, for the https case, through a
+    // real HttpClient (see the end-to-end group below).
+    late ServerSocket echo;
+    final serverSide = <Socket>[];
+    final received = <int>[];
+    late int relayPort;
+
+    setUp(() async {
+      serverSide.clear();
+      received.clear();
+      echo = await ServerSocket.bind(InternetAddress.loopbackIPv4, 0);
+      echo.listen((s) {
+        serverSide.add(s);
+        s.listen((c) {
+          received.addAll(c);
+          s.add(c); // echo back
+        }, onError: (_) => s.destroy());
+      });
+      relayPort = await LoopbackRelay.instance.ensure();
+    });
+
+    tearDown(() {
+      echo.close();
+    });
+
+    test('consumes the 16-byte token and forwards only the payload', () async {
+      final upstream = await Socket.connect('127.0.0.1', echo.port);
+      final token = LoopbackRelay.instance.enqueue(upstream);
+
+      final client = await Socket.connect('127.0.0.1', relayPort);
+      // Token + payload in ONE write: exercises the coalesced leading-bytes
+      // path — the token must be consumed, the payload forwarded.
+      client.add([...token, ..._ascii('ping')]);
+      await _until(() => utf8.decode(received) == 'ping');
+      expect(utf8.decode(received), 'ping');
+      client.destroy();
+      upstream.destroy();
+    });
+
+    test('accepts a fragmented token (slow gate client)', () async {
+      final upstream = await Socket.connect('127.0.0.1', echo.port);
+      final token = LoopbackRelay.instance.enqueue(upstream);
+
+      final client = await Socket.connect('127.0.0.1', relayPort);
+      client.add(token.sublist(0, 8));
+      await client.flush();
+      await pumpEventQueue();
+      client.add([...token.sublist(8), ..._ascii('ok')]);
+      await _until(() => utf8.decode(received) == 'ok');
+      expect(utf8.decode(received), 'ok');
+      client.destroy();
+      upstream.destroy();
+    });
+
+    test(
+      'rejects a wrong token and keeps the parked upstream for the real client',
+      () async {
+        final upstream = await Socket.connect('127.0.0.1', echo.port);
+        final token = LoopbackRelay.instance.enqueue(upstream);
+
+        // An impostor (wrong token) must be dropped without polluting upstream…
+        final impostor = await Socket.connect('127.0.0.1', relayPort);
+        impostor.add(Uint8List.fromList(List.filled(16, 0xAB)));
+        await impostor.flush();
+        await pumpEventQueue();
+        impostor.destroy();
+        await pumpEventQueue();
+        expect(received, isEmpty);
+
+        // …and the parked upstream must still serve the genuine client.
+        final client = await Socket.connect('127.0.0.1', relayPort);
+        client.add([...token, ..._ascii('hi')]);
+        await _until(() => utf8.decode(received) == 'hi');
+        expect(utf8.decode(received), 'hi');
+        client.destroy();
+        upstream.destroy();
+      },
+    );
+  });
+
+  group('spliceNew (the upstream→client pump leg)', () {
+    test('forwards bytes with backpressure wiring in place', () async {
+      // spliceNew pumps `from`'s incoming stream into `to`, so the payload
+      // must be written by the SOURCE server for the pump to carry it.
+      final source = await ServerSocket.bind(InternetAddress.loopbackIPv4, 0);
+      final sinkServer = await ServerSocket.bind(
+        InternetAddress.loopbackIPv4,
+        0,
+      );
+      final sinkSide = <_Reader>[];
+      source.listen((s) => s.add(_ascii('payload')));
+      sinkServer.listen((s) => sinkSide.add(_Reader(s)));
+      addTearDown(() {
+        source.close();
+        sinkServer.close();
+      });
+
+      final from = await Socket.connect('127.0.0.1', source.port);
+      final to = await Socket.connect('127.0.0.1', sinkServer.port);
+      LoopbackRelay.spliceNew(from, to);
+
+      expect(String.fromCharCodes(await sinkSide.single.take(7)), 'payload');
+      from.destroy();
+      to.destroy();
+      for (final r in sinkSide) {
+        r.close();
+      }
+    });
+  });
+
+  group('ResilientHttpOverrides end-to-end', () {
+    test('http to a literal IP goes straight through (native path)', () async {
+      final server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
+      final sub = server.listen((req) async {
+        req.response.write('hello from loopback');
+        await req.response.close();
+      });
+      HttpOverrides.global = ResilientHttpOverrides(HttpOverrides.current);
+      addTearDown(() async {
+        HttpOverrides.global = null;
+        await sub.cancel();
+        await server.close(force: true);
+      });
+
+      final client = HttpClient();
+      final req = await client.getUrl(
+        Uri.parse('http://127.0.0.1:${server.port}/x'),
+      );
+      final res = await req.close();
+      expect(res.statusCode, 200);
+      final body = <int>[];
+      await for (final chunk in res) {
+        body.addAll(chunk);
+      }
+      expect(utf8.decode(body), 'hello from loopback');
+      client.close();
+    });
+
+    test(
+      'https rescue end-to-end: dead OS + DoH IP → TLS in factory → relay',
+      () async {
+        // Trust the test CA process-wide, like installSupplementalTrustRoots
+        // does for the Mozilla bundle.
+        final ca = File('test/fixtures/tls/ca_cert.pem').readAsBytesSync();
+        SecurityContext.defaultContext.setTrustedCertificatesBytes(ca);
+
+        final serverCtx = SecurityContext()
+          ..useCertificateChain('test/fixtures/tls/server_cert.pem')
+          ..usePrivateKey('test/fixtures/tls/server_key.pem');
+        final server = await HttpServer.bindSecure(
+          InternetAddress.anyIPv4,
+          0,
+          serverCtx,
+        );
+        final sub = server.listen((req) async {
+          req.response.write('rescued over DoH');
+          await req.response.close();
+        });
+        HttpOverrides.global = ResilientHttpOverrides(
+          HttpOverrides.current,
+          // Simulate the broken-Private-DNS network: every OS lookup dead…
+          osProbe: (_) async => false,
+          // …and DoH answering with the server's loopback IP.
+          dohResolve: (_) async => [InternetAddress.loopbackIPv4],
+        );
+        addTearDown(() async {
+          HttpOverrides.global = null;
+          await sub.cancel();
+          await server.close(force: true);
+        });
+
+        // Hostname (not a literal) → rescue path: connect to the DoH IP,
+        // TLS with SNI + hostname verification for test.local, opaque relay
+        // socket handed to the SDK. HttpClient must see a normal response.
+        final client = HttpClient();
+        final req = await client.getUrl(
+          Uri.parse('https://test.local:${server.port}/x'),
+        );
+        final res = await req.close();
+        expect(res.statusCode, 200);
+        final body = <int>[];
+        await for (final chunk in res) {
+          body.addAll(chunk);
+        }
+        expect(utf8.decode(body), 'rescued over DoH');
+        client.close();
+      },
+      timeout: const Timeout(Duration(seconds: 30)),
+    );
+  });
+}
