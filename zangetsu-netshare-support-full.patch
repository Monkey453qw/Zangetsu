+import 'dart:async';
+import 'dart:collection';
+import 'dart:io';
+import 'dart:math';
+import 'dart:typed_data';
+
+import 'doh_client.dart';
+
+/// HttpOverrides that make the whole Dart network stack survive a broken OS
+/// resolver — the roadmap's Fix B (explicit DoH upstream) + Fix C (hosts
+/// always reach the proxy as hostnames, resolution happens at one choke
+/// point) applied to this app's own traffic.
+///
+/// The problem it solves: Android "Private DNS" in strict mode resolves
+/// through DNS-over-TLS on TCP :853 (dns.adguard.com et al). On networks that
+/// block :853 — captive portals, some CGNAT/ISP filters — every
+/// `InternetAddress.lookup` stalls and fails, and with it every HttpClient,
+/// dio call, image load and WebSocket in the app freezes until it times out.
+/// The native lanes already have an opt-in DoH (`Doh.kt`), but it covered
+/// only the CloudStream client; this extends the same resilience to the Dart
+/// stack, which carries all streaming.
+///
+/// Behavior on a healthy network is byte-identical to stock: the OS resolver
+/// answers, and the connection is handed to the SDK's own
+/// `SecureSocket.startConnect` path (TLS, SNI, certificate verification and
+/// the client's `badCertificateCallback` all stay with the SDK). DoH is
+/// consulted only after the OS lookup has failed or stalled past a short
+/// timeout, plus a 30s circuit breaker so a dead resolver doesn't cost every
+/// request the probe time.
+///
+/// Install once at startup: `installResilientHttpOverrides()`.
+class ResilientHttpOverrides extends HttpOverrides {
+  ResilientHttpOverrides(this._wrapped, {this.osProbe, this.dohResolve});
+
+  final HttpOverrides? _wrapped;
+
+  /// Test seams — see [connectWithDnsFallback].
+  final Future<bool> Function(String host)? osProbe;
+  final Future<List<InternetAddress>?> Function(String host)? dohResolve;
+
+  @override
+  HttpClient createHttpClient(SecurityContext? context) {
+    // Compose with any override that was already installed (tests, other
+    // tooling) so behavior layers instead of replacing.
+    final client =
+        _wrapped?.createHttpClient(context) ?? super.createHttpClient(context);
+    client.connectionFactory = (Uri uri, String? proxyHost, int? proxyPort) =>
+        connectWithDnsFallback(
+          uri,
+          proxyHost,
+          proxyPort,
+          context,
+          osProbe: osProbe,
+          dohResolve: dohResolve,
+        );
+    return client;
+  }
+}
+
+/// How long the OS resolver gets before we declare it dead for a request.
+/// Healthy lookups answer in single-digit milliseconds; the point of the
+/// budget is to stop waiting before Android's DoT retry ladder gives up on
+/// its own many seconds later.
+const osLookupBudget = Duration(seconds: 3);
+
+/// After a failed OS lookup, skip probing it for this long and go DoH-first.
+Duration osSuspectPeriod = const Duration(seconds: 30);
+
+DateTime _osSuspectUntil = DateTime.fromMillisecondsSinceEpoch(0);
+
+/// Visible for tests.
+void resetResolverState() {
+  _osSuspectUntil = DateTime.fromMillisecondsSinceEpoch(0);
+}
+
+/// The connection decision, factored out pure so the policy is unit-testable
+/// without any network.
+enum ConnectPath {
+  /// Literal IP — nothing to resolve, connect straight to it.
+  nativeLiteral,
+
+  /// OS resolver alive (or DoH unavailable) — stock SDK behavior.
+  native,
+
+  /// OS dead, DoH answered — connect to the resolved IP (plain http).
+  dohPlain,
+
+  /// OS dead, DoH answered — TLS here with the real hostname, then an
+  /// opaque loopback relay socket for the SDK (https).
+  dohTlsRelay,
+}
+
+ConnectPath pickConnectPath({
+  required String host,
+  required bool isSecure,
+  required bool osAlive,
+  required bool dohAlive,
+}) {
+  if (InternetAddress.tryParse(host) != null) return ConnectPath.nativeLiteral;
+  if (osAlive || !dohAlive) return ConnectPath.native;
+  if (isSecure) return ConnectPath.dohTlsRelay;
+  return ConnectPath.dohPlain;
+}
+
+/// The connectionFactory body. See the class docs for the policy.
+///
+/// [osProbe] and [dohResolve] exist for tests only: they replace the live
+/// OS-lookup probe and the DoH resolver so the rescue paths can be exercised
+/// against local sockets. Production calls leave them null.
+Future<ConnectionTask<Socket>> connectWithDnsFallback(
+  Uri uri,
+  String? proxyHost,
+  int? proxyPort,
+  SecurityContext? context, {
+  Future<bool> Function(String host)? osProbe,
+  Future<List<InternetAddress>?> Function(String host)? dohResolve,
+}) async {
+  // Proxied requests keep stock behavior: connect to the proxy; the SDK
+  // builds the CONNECT tunnel and does TLS itself (createProxyTunnel).
+  if (proxyHost != null) return Socket.startConnect(proxyHost, proxyPort!);
+
+  final isSecure = uri.scheme == 'https';
+  final host = uri.host;
+  final port = uri.port == 0 ? (isSecure ? 443 : 80) : uri.port;
+
+  Future<ConnectionTask<Socket>> native() => isSecure
+      ? SecureSocket.startConnect(host, port, context: context)
+      : Socket.startConnect(host, port);
+
+  // Literal IPs (the local cast/external stream proxies advertise
+  // http://<lan-ip>:<port>/…) must never touch a resolver.
+  final isLiteral = InternetAddress.tryParse(host) != null;
+
+  var osAlive = true;
+  if (!isLiteral && DateTime.now().isAfter(_osSuspectUntil)) {
+    osAlive = osProbe != null
+        ? await osProbe(host)
+        : await _osLookupAlive(host);
+    if (osAlive) {
+      resetResolverState();
+    } else {
+      _osSuspectUntil = DateTime.now().add(osSuspectPeriod);
+    }
+  } else if (!isLiteral) {
+    osAlive = false;
+  }
+
+  if (isLiteral || osAlive) return native();
+
+  // OS resolver is dead → explicit DoH (the Fix-B upstream).
+  final ips = dohResolve != null
+      ? await dohResolve(host)
+      : await DohClient.instance.lookup(host);
+  if (ips == null || ips.isEmpty) return native(); // surface the real error
+
+  if (!isSecure) return Socket.startConnect(ips.first, port);
+
+  // https rescue. With a connectionFactory the SDK treats the returned
+  // socket as final — no TLS is applied later (verified against the SDK
+  // source: no startSecure on the direct path). So the TLS handshake
+  // happens HERE, against `host`, keeping SNI and certificate verification
+  // correct — connecting by IP with SNI=IP would fail hostname checks and
+  // get SNI-rejected by many CDNs. The TLS socket is then paired 1:1 with
+  // a loopback relay socket the SDK can treat as an opaque connection.
+  SecureSocket? tls;
+  try {
+    for (final ip in ips) {
+      try {
+        final raw = await Socket.startConnect(ip, port)
+            .then((t) => t.socket)
+            .timeout(
+              const Duration(seconds: 5),
+              onTimeout: () {
+                throw SocketException('connect timeout ($host)');
+              },
+            );
+        tls = await SecureSocket.secure(raw, host: host, context: context)
+            .timeout(
+              const Duration(seconds: 7),
+              onTimeout: () {
+                throw SocketException('TLS timeout ($host)');
+              },
+            );
+        break;
+      } on Exception catch (_) {
+        try {
+          tls?.destroy();
+        } catch (_) {}
+        tls = null;
+        // next resolved address
+      }
+    }
+    if (tls == null) return native(); // every address failed — real error out
+
+    final relayPort = await LoopbackRelay.instance.ensure();
+    final token = LoopbackRelay.instance.enqueue(tls);
+    // `Socket.startConnect` yields a Future<ConnectionTask> — the factory's
+    // contract is to return exactly that future, so the SDK gets the real
+    // task (with working cancel()) rather than a wrapper.
+    final task = Socket.startConnect(InternetAddress.loopbackIPv4, relayPort);
+    // Gate handshake: identify ourselves before any HTTP bytes flow, so the
+    // relay never pipes for some other app that found the port (loopback is
+    // shared between Android apps). Sent before the SDK's first write lands.
+    final connTask = await task.timeout(const Duration(seconds: 3));
+    final client = await connTask.socket.timeout(const Duration(seconds: 3));
+    client.add(token);
+    await client.flush();
+    return connTask;
+  } on Exception {
+    try {
+      tls?.destroy();
+    } catch (_) {}
+    return native(); // rescue failed → behave exactly like stock would have
+  }
+}
+
+Future<bool> _osLookupAlive(String host) async {
+  try {
+    final result = await InternetAddress.lookup(host).timeout(osLookupBudget);
+    return result.isNotEmpty;
+  } on Exception {
+    return false; // SocketException (resolver dead) or TimeoutException
+  }
+}
+
+/// Pairs sockets produced by the https rescue path with the SDK.
+///
+/// `ConnectionTask` has no public constructor, so the factory cannot wrap an
+/// already-established TLS socket in one. Instead the TLS socket is parked
+/// here and the factory returns a loopback connect task; each accepted
+/// loopback connection is then spliced byte-for-byte onto its parked TLS
+/// socket. The HTTP layer never notices: for the SDK the relay socket is an
+/// opaque, bidirectional, keep-alive-capable connection — exactly what a
+/// normal socket is.
+class LoopbackRelay {
+  LoopbackRelay._();
+
+  static final LoopbackRelay instance = LoopbackRelay._();
+
+  ServerSocket? _server;
+  final Queue<_Parked> _pending = Queue();
+  final Random _random = Random.secure();
+
+  /// Idle cap on parked sockets — nothing should sit here long (the factory
+  /// connects loopback within the same event-loop turn sequence), but a crash
+  /// between enqueue and connect must not leak TLS sockets.
+  static const _parkBudget = Duration(seconds: 10);
+
+  Future<int> ensure() async {
+    final existing = _server;
+    if (existing != null) return existing.port;
+    final server = await ServerSocket.bind(InternetAddress.loopbackIPv4, 0);
+    server.listen(_accept, onError: (_) {});
+    _server = server;
+    return server.port;
+  }
+
+  /// Parks [upstream] and returns the 16-byte token the client must present.
+  /// Takes a plain [Socket] so tests can pair a mock upstream; production
+  /// always hands in the SecureSocket from the rescue path.
+  Uint8List enqueue(Socket upstream) {
+    final token = Uint8List(16);
+    for (var i = 0; i < 16; i++) {
+      token[i] = _random.nextInt(256);
+    }
+    final parked = _Parked(upstream, token);
+    _pending.addLast(parked);
+    Timer(_parkBudget, () {
+      if (_pending.remove(parked)) {
+        try {
+          upstream.destroy();
+        } catch (_) {}
+      }
+    });
+    return token;
+  }
+
+  void _accept(Socket client) {
+    final _Parked parked;
+    try {
+      if (_pending.isEmpty) {
+        client.destroy();
+        return;
+      }
+      parked = _pending.removeFirst();
+    } catch (_) {
+      client.destroy();
+      return;
+    }
+    _gate(client, parked);
+  }
+
+  /// Reads the 16-byte token, then splices the client onto the parked
+  /// upstream. Anything past the token (TCP may coalesce it with the first
+  /// HTTP bytes) is carried into the pipe.
+  ///
+  /// The pipe's client leg REUSES the subscription opened here: dart:io
+  /// socket streams are single-subscription, so cancelling to re-listen in
+  /// [spliceNew] would throw "Stream has already been listened to" on every
+  /// rescue. The handlers are swapped on the live subscription instead.
+  void _gate(Socket client, _Parked parked) {
+    final upstream = parked.upstream;
+    final buffer = BytesBuilder(copy: false);
+    var done = false;
+    late final StreamSubscription<Uint8List> sub;
+
+    void die() {
+      try {
+        client.destroy();
+      } catch (_) {}
+      try {
+        upstream.destroy();
+      } catch (_) {}
+    }
+
+    void unpair() {
+      try {
+        client.destroy();
+      } catch (_) {}
+      _pending.addFirst(parked);
+    }
+
+    // A gate that never finishes must not hold the TLS socket forever.
+    final gateTimer = Timer(const Duration(seconds: 3), () {
+      if (done) return;
+      done = true;
+      try {
+        sub.cancel();
+      } catch (_) {}
+      unpair();
+    });
+
+    sub = client.listen(
+      (chunk) {
+        if (done) return;
+        buffer.add(chunk);
+        if (buffer.length < 16) return;
+        done = true;
+        gateTimer.cancel();
+        final bytes = buffer.takeBytes();
+        for (var i = 0; i < 16; i++) {
+          if (bytes[i] != parked.token[i]) {
+            // Wrong token — some other process found the port. Refuse, and
+            // keep the parked socket available for the real client (its own
+            // connect is already in flight; the next accept pairs with it).
+            unpair();
+            return;
+          }
+        }
+        try {
+          final leading = bytes.length > 16
+              ? Uint8List.sublistView(bytes, 16)
+              : null;
+          if (leading != null && leading.isNotEmpty) upstream.add(leading);
+          // Swap the gate's handlers into a pipe: client → upstream keeps
+          // this subscription (with backpressure), upstream → client opens
+          // a fresh one.
+          sub
+            ..onData((chunk) {
+              upstream.add(chunk);
+              sub.pause();
+              upstream
+                  .flush()
+                  .then((_) {
+                    try {
+                      sub.resume(); // destroyed peer → the add throws → onError
+                    } catch (_) {
+                      die();
+                    }
+                  })
+                  .catchError((Object _) => die());
+            })
+            ..onDone(die)
+            ..onError((Object _) => die());
+          spliceNew(upstream, client);
+        } catch (_) {
+          die();
+        }
+      },
+      onDone: () {
+        if (!done) {
+          // Client vanished before completing the handshake — give the parked
+          // socket back to the front of the queue for the next accept (the
+          // real client's connect may still be in flight; if it was this
+          // client that died, the park timer reclaims the socket instead).
+          done = true;
+          gateTimer.cancel();
+          unpair();
+        }
+      },
+      onError: (_) {
+        if (!done) {
+          done = true;
+          gateTimer.cancel();
+          unpair();
+        } else {
+          die();
+        }
+      },
+      cancelOnError: false,
+    );
+  }
+
+  /// Bidirectional pump over two FRESH subscriptions, with backpressure: the
+  /// reader is paused while the writer's buffer drains, so a 4K segment flood
+  /// can't buffer unboundedly.
+  static void spliceNew(Socket from, Socket to) {
+    void die() {
+      try {
+        from.destroy();
+      } catch (_) {}
+      try {
+        to.destroy();
+      } catch (_) {}
+    }
+
+    late final StreamSubscription<Uint8List> sub;
+    sub = from.listen(
+      (chunk) {
+        to.add(chunk);
+        sub.pause();
+        to
+            .flush()
+            .then((_) {
+              try {
+                sub.resume(); // destroyed peer → the add throws → onError
+              } catch (_) {
+                die();
+              }
+            })
+            .catchError((Object _) => die());
+      },
+      onDone: die,
+      onError: (_) => die(),
+    );
+  }
+}
+
+class _Parked {
+  _Parked(this.upstream, this.token);
+  final Socket upstream;
+  final Uint8List token;
+}
+
+/// Installs the resilient resolver as the process-wide default. Every
+/// `HttpClient()` afterwards — dio adapters, image loads, Supabase/Firebase,
+/// WebSockets, the cast proxy's own upstream client — inherits the
+/// OS-first/DoH-fallback behavior. Idempotent (keeps the existing override as
+/// the wrapped delegate on repeat calls).
+///
+/// Runs the one-shot provider sync (dns_choice → DoH provider) in the
+/// background; until it lands the resolver defaults to Cloudflare.
+void installResilientHttpOverrides() {
+  if (HttpOverrides.current is ResilientHttpOverrides) return;
+  unawaited(DohClient.configureFromNativePrefs());
+  HttpOverrides.global = ResilientHttpOverrides(HttpOverrides.current);
+}
